{
  "name": "zxd-training-hub",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:all": "pnpm build && pnpm --dir functions build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "admins:grant": "node scripts/grant-admin-access.mjs",
    "emulators": "firebase emulators:start",
    "deploy": "pnpm build:all && firebase deploy"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "firebase": "12.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "firebase-tools": "15.27.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
